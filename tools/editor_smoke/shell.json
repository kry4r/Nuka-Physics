{
  "name": "shell",
  "launch": [],
  "steps": [
    {"frames": 10},
    {"screenshot": "00_empty"},
    {"action": "file.open", "args": {"path": "${scenario_dir}/../../examples/assets/nuka_lab/stage.nks"}},
    {"frames": 30},
    {"action": "scene.spawn", "args": {"kind": "box", "pose": {"pos": [0.0, 0.0, 0.6], "quat": [1.0, 0.0, 0.0, 0.0]}},
     "bind": "box"},
    {"frames": 10},
    {"screenshot": "01_authoring"},

    {"action": "window.layout_debug"},
    {"action": "view.colliders"},
    {"frames": 6},
    {"screenshot": "02_debug"},
    {"action": "view.hide_overlays"},
    {"action": "window.layout_robot"},
    {"frames": 6},
    {"screenshot": "03_robot"},
    {"action": "window.layout_data"},
    {"frames": 6},
    {"screenshot": "04_data"},
    {"action": "window.layout_training"},
    {"frames": 6},
    {"screenshot": "05_training"},
    {"action": "window.layout_authoring"},
    {"frames": 4},

    {"action": "view.ui_scale", "args": {"value": 1.25}},
    {"frames": 6},
    {"screenshot": "06_scale125"},
    {"action": "view.ui_scale", "args": {"value": 1.5}},
    {"frames": 6},
    {"screenshot": "07_scale150"},
    {"action": "view.ui_scale_reset"},
    {"action": "view.ui_scale", "args": {"value": 9.0}, "bind": "clamped"},
    {"python": "assert ${clamped} == 3.0, ${clamped}"},
    {"action": "view.ui_scale_reset"},
    {"action": "window.layout_nope", "expect_error": true},
    {"action": "window.focus", "args": {"panel": "nope"}, "expect_error": true},

    {"action": "edit.rename", "args": {"path": "${box.focus}", "name": "箱子一号"}, "bind": "renamed"},
    {"expect": {"selection": "${renamed.focus}"}},
    {"action": "script.run", "args": {"code": "print('脚本输出：你好，Nuka 编辑器')"}},
    {"python": "import math\np = app.ui.panel('tools', '机器人工具', dock='right', icon='robot')\np.label('脚本面板：中文标签与图标', style='strong')\nrow = p.hstack()\nrow.button('复位', icon='reset', action='sim.reset')\nrow.button('提示', icon='info', on_click=lambda: app.ui.toast('按钮已点击', 'ok'))\ng = p.float_field('增益', value=1.5, min=0.0, max=4.0, slider=True)\np.toggle('启用', value=True)\np.segmented(['低', '中', '高'], value=1)\np.progress(0.6, label='训练进度')\np.badge('live', tone='ok', icon='live')\np.plot([{'name': 'sin', 'x': [i * 0.1 for i in range(64)], 'y': [math.sin(i * 0.1) for i in range(64)]}], height=80)\np.set(focus=True)\nassert g.value == 1.5, g.value\ng.value = 2.25\nassert g.value == 2.25, g.value\napp.ui.progress('train', '训练 epoch 3/10', 0.3)"},
    {"action": "ui.toast", "args": {"text": "你好，Nuka 编辑器", "level": "ok"}},
    {"action": "ui.toast", "args": {"text": "Collider budget nearly full", "level": "warn"}},
    {"action": "scene.select", "args": {"path": "no/such/node"}, "expect_error": true},
    {"frames": 6},
    {"screenshot": "08_cjk_panel_toasts"},

    {"action": "app.command_palette"},
    {"frames": 4},
    {"screenshot": "09_palette"},
    {"action": "app.command_palette"},

    {"action": "window.focus", "args": {"panel": "stats"}},
    {"action": "sim.play"},
    {"tick": 240},
    {"screenshot": "10_stats_live"},
    {"action": "sim.pause"},

    {"action": "tools.nui_inspector"},
    {"frames": 6},
    {"screenshot": "11_inspector"},
    {"action": "tools.nui_inspector"},
    {"python": "app.ui.panel('tools').remove()"},
    {"frames": 4},

    {"action": "help.about"},
    {"frames": 6},
    {"screenshot": "12_about"}
  ]
}
