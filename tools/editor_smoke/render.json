{
  "name": "render",
  "launch": ["--cams", "${scenario_dir}/render_cams.json"],
  "steps": [
    {"action": "file.open", "args": {"path": "${scenario_dir}/../../examples/assets/nuka_lab/stage.nks"}},
    {"frames": 20},
    {"action": "view.bookmarks", "bind": "cams"},
    {"python": "c = ${cams}\nassert [b['name'] for b in c] == ['hero'] and c[0]['distance'] == 3.5, c"},
    {"action": "scene.spawn", "args": {"kind": "box", "pose": {"pos": [0.0, 0.0, 0.5], "quat": [1.0, 0.0, 0.0, 0.0]}}},
    {"frames": 10},
    {"action": "view.frame_all"},
    {"frames": 10},

    {"action": "view.rt_status", "expect_value": {"on": false, "shown": false}},
    {"action": "view.rt_preview", "args": {"on": true, "max_spp": 16}, "expect_value": {"on": true, "max_spp": 16}},
    {"wait": "view.rt_status", "until": {"converged": true}, "bind": "rt"},
    {"python": "r = ${rt}\nprint('RT', r)\nassert r['done'] == [1, 2, 4, 8, 16] and r['spp'] == 16 and r['shown'] and r['error'] is None, r"},
    {"screenshot": "00_rt"},
    {"action": "view.rt_save", "args": {"path": "${out}/rt.png"}, "bind": "saved"},
    {"python": "from PIL import Image\nr, s = ${rt}, ${saved}\nim = Image.open(s['path'])\nprint('RT IMAGE', im.size, im.getextrema())\nassert im.size == (r['width'], r['height']) and s['spp'] == 16, (im.size, r, s)\nassert all(hi - lo > 40 for lo, hi in im.getextrema()), im.getextrema()"},

    {"action": "view.bookmark_add", "args": {"name": "front"}, "expect_value": {"name": "front", "count": 2}},
    {"action": "view.bookmark_goto", "args": {"name": "hero"}, "expect_value": {"name": "hero"}},
    {"frames": 2},
    {"action": "view.rt_status", "bind": "moved"},
    {"python": "m = ${moved}\nprint('RT MOVED', m)\nassert not m['converged'] and len(m['done']) < 5 and m['done'] == [1, 2, 4, 8, 16][:len(m['done'])], m"},
    {"wait": "view.rt_status", "until": {"converged": true}, "bind": "rt2"},
    {"python": "r = ${rt2}\nassert r['done'] == [1, 2, 4, 8, 16], r"},
    {"screenshot": "01_rt_hero"},
    {"action": "view.bookmark_add", "args": {"name": "check"}},
    {"action": "view.bookmarks", "bind": "cams2"},
    {"python": "c = {b['name']: b for b in ${cams2}}\nh, k = c['hero'], c['check']\nassert all(abs(h[f] - k[f]) < 1e-3 for f in ['distance', 'yaw', 'pitch', 'fov']), (h, k)\nassert all(abs(a - b) < 1e-3 for a, b in zip(h['target'], k['target'])), (h, k)"},
    {"action": "view.bookmark_remove", "args": {"name": "check"}, "expect_value": {"count": 2}},
    {"action": "view.bookmark_rename", "args": {"name": "front", "to": "hero"}, "expect_error": true},
    {"action": "view.bookmark_rename", "args": {"name": "front", "to": "side"}, "expect_value": {"name": "side"}},
    {"action": "view.bookmark_goto", "args": {"name": "front"}, "expect_error": true},
    {"action": "view.bookmark_add", "bind": "auto"},
    {"python": "assert ${auto} == {'name': 'View 3', 'count': 3}, ${auto}"},
    {"screenshot": "02_bookmarks"},
    {"action": "view.bookmarks_save", "args": {"path": "${out}/cams.json"}, "expect_value": {"count": 3}},
    {"action": "view.bookmark_remove", "args": {"name": "hero"}},
    {"action": "view.bookmark_remove", "args": {"name": "side"}},
    {"action": "view.bookmark_remove", "args": {"name": "View 3"}, "expect_value": {"count": 0}},
    {"python": "import pathlib\nassert not list(pathlib.Path(r'${profile}', 'bookmarks').glob('*.json'))"},
    {"action": "view.bookmarks_load", "args": {"path": "${out}/cams.json"}, "expect_value": {"count": 3}},
    {"python": "import pathlib\nassert len(list(pathlib.Path(r'${profile}', 'bookmarks').glob('*.json'))) == 1"},
    {"action": "view.rt_preview", "args": {"on": false}, "expect_value": {"on": false}},
    {"action": "file.close", "args": {"discard": true}},
    {"action": "file.open", "args": {"path": "${scenario_dir}/../../examples/assets/nuka_lab/stage.nks"}},
    {"frames": 10},
    {"action": "view.bookmarks", "bind": "cams3"},
    {"python": "assert [b['name'] for b in ${cams3}] == ['hero', 'side', 'View 3'], ${cams3}"},

    {"action": "view.bookmark_goto", "args": {"name": "hero"}},
    {"action": "view.render", "args": {"path": "${out}/missing/render.png"}, "expect_error": true},
    {"action": "view.render", "args": {"path": "${out}/render.png", "width": 320, "height": 180, "spp": 16}},
    {"action": "view.render", "args": {"path": "${out}/render2.png"}, "expect_error": true},
    {"action": "view.render_status", "expect_value": {"running": true}},
    {"frames": 4},
    {"screenshot": "03_rendering"},
    {"wait": "view.render_status", "until": {"running": false}, "bind": "job"},
    {"python": "from PIL import Image\nd = ${job}['last']\nprint('RENDER', d)\nassert d['ok'], d\nim = Image.open(r'${out}/render.png')\nprint('RENDER IMAGE', im.size, im.getextrema())\nassert im.size == (320, 180) and all(hi - lo > 40 for lo, hi in im.getextrema()), (im.size, im.getextrema())"},
    {"python": "import os\nos.makedirs(r'${out}/taken.png', exist_ok=True)"},
    {"action": "view.render", "args": {"path": "${out}/taken.png", "width": 64, "height": 36, "spp": 1}},
    {"wait": "view.render_status", "until": {"running": false}, "bind": "failed"},
    {"python": "d = ${failed}['last']\nprint('RENDER FAILED', d)\nassert not d['ok'] and d['error'], d"}
  ]
}
