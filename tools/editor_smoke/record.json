{
  "name": "record",
  "launch": [],
  "steps": [
    {"action": "file.open", "args": {"path": "${scenario_dir}/../../examples/assets/nuka_lab/stage.nks"}},
    {"frames": 20},
    {"action": "scene.spawn", "args": {"kind": "box", "pose": {"pos": [0.0, 0.0, 1.4], "quat": [1.0, 0.0, 0.0, 0.0]}}, "bind": "box"},
    {"frames": 10},
    {"action": "window.layout_debug"},
    {"action": "view.frame_all"},
    {"wait": "timeline.status", "until": {"tick": 0, "head": 0}},
    {"tick": 30},
    {"wait": "timeline.status", "until": {"tick": 30}},
    {"action": "sim.perturb", "args": {"path": "${box.focus}", "force": [0.0, 0.0, 15.0]}},
    {"tick": 10},
    {"wait": "timeline.status", "until": {"tick": 40}},
    {"action": "timeline.hash", "bind": "h40"},
    {"tick": 20},
    {"wait": "timeline.status", "until": {"tick": 60}},
    {"action": "sim.release"},
    {"tick": 20},
    {"wait": "timeline.status", "until": {"tick": 80}},
    {"action": "timeline.hash", "bind": "h80"},
    {"tick": 10},
    {"wait": "timeline.status", "until": {"tick": 90, "head": 90}},

    {"action": "timeline.seek", "args": {"tick": 50}},
    {"wait": "timeline.status", "until": {"tick": 50, "applied": true}},
    {"action": "timeline.save", "args": {"path": "${out}/run.nkrec"}, "bind": "saved"},
    {"python": "s = ${saved}\nassert s['start'] == 0 and s['head'] == 90 and s['keyframes'] >= 6 and s['inputs'] == 2, s"},
    {"python": "import os\nfrom nuka.editor import nkrec\nr = nkrec.read('${out}/run.nkrec')\nm = r.manifest\nassert m['tick'] == 50 and m['head'] == 90 and m['exact'] and m['format'] == 2, m\nassert len(r.keyframes) == m['keyframes'] and r.inputs == 2, (len(r.keyframes), r.inputs)\nassert any(k.loads for k in r.keyframes), [k.loads for k in r.keyframes]\nassert r.samples and r.samples[0].bodies.shape[1] == 7 and r.samples[-1].tick <= 90, len(r.samples)\nassert len(m['bodies']) == r.samples[0].bodies.shape[0], (m['bodies'], r.samples[0].bodies.shape)\nout = nkrec.to_rerun(r, '${out}/run.rrd')\nassert os.path.getsize(out) > 0, out"},

    {"action": "timeline.clear"},
    {"tick": 20},
    {"wait": "timeline.status", "until": {"tick": 70, "start": 50, "head": 70}},
    {"action": "timeline.load", "args": {"path": "${out}/run.nkrec"}, "bind": "loaded"},
    {"python": "assert ${loaded}['tick'] == 50 and ${loaded}['head'] == 90, ${loaded}"},
    {"wait": "timeline.status", "until": {"tick": 50, "start": 0, "head": 90}, "bind": "ls"},
    {"python": "s = ${ls}\nassert len(s['branches']) == 1 and s['branches'][0]['exact'] and 90 in s['keys'], s"},
    {"action": "timeline.seek", "args": {"tick": 40}},
    {"wait": "timeline.status", "until": {"tick": 40, "applied": true}},
    {"action": "timeline.hash", "bind": "r40"},
    {"python": "assert ${r40}['hash'] == ${h40}['hash'], (${h40}, ${r40})"},
    {"action": "timeline.seek", "args": {"tick": 80}},
    {"wait": "timeline.status", "until": {"tick": 80, "applied": true}},
    {"action": "timeline.hash", "bind": "r80"},
    {"python": "assert ${r80}['hash'] == ${h80}['hash'], (${h80}, ${r80})"},
    {"action": "window.focus", "args": {"panel": "timeline"}},
    {"action": "view.frame_selected"},
    {"python": "import time; time.sleep(4.5)"},
    {"frames": 10},
    {"screenshot": "00_loaded"},
    {"action": "view.language", "args": {"locale": "zh-CN"}},
    {"frames": 10},
    {"screenshot": "01_zh"},
    {"action": "view.language", "args": {"locale": "en"}},
    {"frames": 5},

    {"action": "timeline.export", "args": {"path": "${out}/run.mp4", "fps": 20}, "bind": "ex"},
    {"python": "import time\ndeadline = time.monotonic() + 120.0\nwhile app.actions.run('timeline.status')['export'] is not None:\n    assert time.monotonic() < deadline, app.actions.run('timeline.status')['export']\n    app.update(True)\ns = app.actions.run('timeline.status')\nassert s['exported']['error'] == '' and s['exported']['frames'] == ${ex}['frames'], s['exported']"},
    {"wait": "timeline.status", "until": {"tick": 80, "applied": true}},
    {"python": "import av, numpy as np\nwith av.open('${out}/run.mp4') as c:\n    frames = [f.to_ndarray(format='rgb24').astype(np.int16) for f in c.decode(video=0)]\nassert len(frames) == ${ex}['frames'] and len(frames) >= 5, (len(frames), ${ex})\nmoved = float(np.abs(frames[-1] - frames[0]).mean())\nassert moved > 0.5, moved"},

    {"action": "timeline.load", "args": {"path": "${out}/missing.nkrec"}, "expect_error": true},
    {"action": "timeline.load", "args": {"path": "${scenario_dir}/record.json"}, "expect_error": true},
    {"action": "timeline.export", "args": {"path": "${out}/bad.mp4", "fps": 0}, "expect_error": true},
    {"action": "timeline.export", "args": {"path": "${out}/bad.mp4", "from": 100000}, "expect_error": true},
    {"action": "scene.spawn", "args": {"kind": "sphere", "pose": {"pos": [0.5, 0.0, 1.4], "quat": [1.0, 0.0, 0.0, 0.0]}}},
    {"frames": 10},
    {"action": "timeline.load", "args": {"path": "${out}/run.nkrec"}, "expect_error": true},
    {"action": "file.close", "args": {"discard": true}},
    {"frames": 4},
    {"expect": {"loaded": false}},
    {"action": "timeline.save", "args": {"path": "${out}/none.nkrec"}, "expect_error": true}
  ]
}
