{
  "name": "scene",
  "launch": [],
  "steps": [
    {"frames": 10},
    {"action": "assets.add_folder", "args": {"path": "${scenario_dir}/../../examples/scenes"}, "bind": "folder"},
    {"action": "assets.add_folder", "args": {"path": "${out}/no_such_folder"}, "expect_error": true},
    {"action": "assets.list", "args": {"pictures": true}, "bind": "lib"},
    {"python": "kinds = {c['kind'] for c in ${lib}['cards']}\nassert {'urdf', 'mjcf', 'usd', 'mesh'} <= kinds, kinds\nassert ${folder}['path'] in ${lib}['roots'], ${lib}['roots']"},
    {"action": "file.open", "args": {"path": "${scenario_dir}/../../examples/assets/nuka_lab/stage.nks"}},
    {"frames": 30},
    {"action": "window.focus", "args": {"panel": "assets"}},
    {"frames": 60},
    {"screenshot": "00_assets"},

    {"action": "file.import_analyze", "args": {"path": "${scenario_dir}/../../examples/scenes/go2_stand.urdf"},
     "bind": "strict", "expect_value": {"kind": "urdf", "profile": "strict"}},
    {"action": "file.import_analyze", "args": {"path": "${scenario_dir}/../../examples/scenes/go2_stand.urdf", "profile": "legacy"},
     "bind": "legacy", "expect_value": {"kind": "urdf", "profile": "legacy", "ok": true}},
    {"python": "s = ${legacy}['stats']\nassert s['links'] > 1 and s['joints'] > 0 and s['mass'] > 0.0, s"},
    {"action": "file.import_analyze", "args": {"path": "${scenario_dir}/../../examples/assets/bdx/open_duck_mini_v2.xml"},
     "bind": "duck", "expect_value": {"kind": "mjcf", "ok": true}},
    {"python": "assert not ${duck}['diagnostics'] and ${duck}['stats']['links'] == 16, ${duck}"},
    {"action": "file.import_analyze", "args": {"path": "${scenario_dir}/../../examples/scenes/complete_robot.xml"},
     "expect_value": {"kind": "mjcf", "ok": true}},
    {"action": "file.import_analyze", "args": {"path": "${scenario_dir}/../../tests/data/mounted_loads.xml"},
     "bind": "loads", "expect_value": {"kind": "mjcf", "ok": true}},
    {"python": "s = ${loads}['stats']\nassert s['links'] == 3 and s['joints'] == 2, s"},
    {"action": "file.import_analyze", "args": {"path": "${scenario_dir}/../../examples/assets/bdx/assets/head.stl"},
     "expect_value": {"kind": "mesh", "ok": true}},
    {"action": "file.import_analyze", "args": {"path": "${scenario_dir}/scene.json"}, "expect_value": {"kind": "unknown", "ok": false}},
    {"action": "file.import", "args": {"path": "${out}/missing.urdf", "mode": "add"}, "expect_error": true},
    {"action": "file.import", "args": {"path": "${scenario_dir}/../../examples/scenes/go2_stand.urdf", "mode": "nope"}, "expect_error": true},

    {"mark": "m0"},
    {"action": "file.import", "args": {"path": "${scenario_dir}/../../examples/scenes/go2_stand.urdf",
     "pose": {"pos": [1.0, 0.5, 0.0], "quat": [1.0, 0.0, 0.0, 0.0]}}},
    {"frames": 8},
    {"screenshot": "01_import_wizard"},
    {"action": "file.import", "args": {"path": "${scenario_dir}/../../examples/scenes/go2_stand.urdf", "mode": "add",
     "profile": "legacy", "name": "go2", "pose": {"pos": [1.0, 0.5, 0.0], "quat": [1.0, 0.0, 0.0, 0.0]}}, "bind": "robot"},
    {"frames": 8},
    {"mark": "m1", "differs_from": "m0"},
    {"expect": {"dirty": true, "undo": 1}},
    {"undo": 1},
    {"expect": {"undo": 0}, "same_as": "m0"},
    {"action": "edit.redo"},
    {"expect": {"undo": 1}, "same_as": "m1"},
    {"action": "file.import", "args": {"path": "${scenario_dir}/../../examples/assets/bdx/open_duck_mini_v2.xml", "mode": "add"},
     "expect_error": true},
    {"action": "file.import", "args": {"path": "${scenario_dir}/../../examples/scenes/complete_robot.xml", "mode": "add",
     "name": "hinged"}, "expect_error": true},
    {"action": "file.import", "args": {"path": "${scenario_dir}/../../tests/data/mounted_loads.xml", "mode": "add",
     "name": "arm", "pose": {"pos": [-1.0, 0.5, 0.0], "quat": [1.0, 0.0, 0.0, 0.0]}}, "expect_error": true},
    {"expect": {"undo": 1}, "same_as": "m1"},
    {"action": "file.import", "args": {"path": "${scenario_dir}/../../examples/assets/bdx/assets/head.stl", "mode": "auto",
     "pose": {"pos": [0.0, -1.0, 0.0], "quat": [1.0, 0.0, 0.0, 0.0]}}, "bind": "mesh"},
    {"action": "scene.spawn", "args": {"kind": "box", "pose": {"pos": [0.0, -2.0, 0.5], "quat": [1.0, 0.0, 0.0, 0.0]}}, "bind": "box"},
    {"expect": {"undo": 3}},
    {"frames": 8},

    {"action": "scene.select", "args": {"path": "${mesh.focus}"}},
    {"action": "scene.select", "args": {"path": "${box.focus}", "mode": "add"},
     "expect_value": {"path": "${box.focus}", "selection": ["${box.focus}", "${mesh.focus}"]}},
    {"action": "scene.select", "args": {"path": "${box.focus}", "mode": "toggle"},
     "expect_value": {"path": "${mesh.focus}", "selection": ["${mesh.focus}"]}},
    {"action": "scene.select", "args": {"path": "${robot.focus}", "mode": "range", "paths": ["${robot.focus}", "${mesh.focus}"]},
     "expect_value": {"path": "${robot.focus}", "selection": ["${robot.focus}", "${mesh.focus}"]}},
    {"action": "scene.select", "args": {"path": "${robot.focus}", "mode": "nope"}, "expect_error": true},
    {"action": "scene.collision_preview", "args": {"method": "hull", "subtree": true, "replace": true}, "bind": "preview"},
    {"python": "built = [r['path'] for r in ${preview} if r['skipped'] == '']\nassert built and all(r['skipped'] in ('', 'no visual mesh') for r in ${preview}), ${preview}"},
    {"action": "scene.collision_dialog"},
    {"frames": 8},
    {"screenshot": "02_collision_dialog"},
    {"action": "scene.generate_collision", "args": {"method": "hull", "subtree": true, "replace": true}},
    {"frames": 8},
    {"expect": {"undo": 4}},
    {"action": "scene.collision_preview", "args": {"method": "hull", "subtree": true, "only_missing": true}, "bind": "after"},
    {"python": "built = {r['path'] for r in ${preview} if r['skipped'] == ''}\nassert all(r['skipped'] == 'has a collider' for r in ${after} if r['path'] in built), ${after}"},
    {"action": "scene.select", "args": {"path": "${mesh.focus}"}},
    {"action": "scene.generate_collision", "args": {"method": "vhacd", "max_pieces": 8, "replace": true}},
    {"action": "scene.select", "args": {"path": "${box.focus}"}},
    {"action": "scene.generate_collision", "args": {"method": "sdf"}, "expect_error": true},
    {"action": "scene.select", "args": {"path": "${mesh.focus}"}},
    {"action": "scene.generate_collision", "args": {"method": "sdf", "replace": true}},
    {"expect": {"undo": 6}},
    {"action": "view.colliders"},
    {"action": "scene.select", "args": {"path": "${robot.focus}", "mode": "add"}},
    {"action": "view.frame_selected"},
    {"python": "import time; time.sleep(8.5)"},
    {"frames": 8},
    {"screenshot": "03_colliders"},
    {"action": "view.hide_overlays"},
    {"action": "scene.select", "args": {"path": "${mesh.focus}"}},

    {"mark": "p0"},
    {"action": "edit.apply", "args": {"label": "Mass", "ops": [{"target": "${mesh.focus}", "field": "body.mass", "after": 2.5}]}},
    {"action": "edit.apply", "args": {"label": "Gravity", "ops": [{"target": "", "field": "gravity_z", "after": -4.0}]}},
    {"expect": {"undo": 8}},
    {"frames": 8},
    {"screenshot": "04_properties"},
    {"undo": 2},
    {"expect": {"undo": 6}, "same_as": "p0"},

    {"action": "scene.set_visible", "args": {"path": "${robot.focus}", "value": false}, "expect_value": {"visible": false}},
    {"action": "scene.set_locked", "args": {"path": "${box.focus}", "value": true}, "expect_value": {"locked": true}},
    {"action": "scene.select", "args": {"path": "${box.focus}"}},
    {"action": "scene.select", "args": {"path": "${mesh.focus}", "mode": "add"}},
    {"action": "window.focus", "args": {"panel": "stage"}},
    {"frames": 8},
    {"screenshot": "05_stage_flags"},
    {"action": "scene.set_visible", "args": {"path": "${robot.focus}"}, "expect_value": {"visible": true}},
    {"action": "scene.set_locked", "args": {"path": "${box.focus}"}, "expect_value": {"locked": false}},
    {"expect": {"undo": 6}},

    {"mark": "d0"},
    {"action": "edit.delete"},
    {"expect": {"undo": 7}},
    {"undo": 1},
    {"expect": {"undo": 6}, "same_as": "d0"},
    {"save_reopen": "${out}/scene_s1.nks"},
    {"tick": 100},
    {"python": "import numpy as np, nuka\nfor f in (nuka.Field.ARTICULATION_LINK_POSE, nuka.Field.RIGID_BODY_TRANSFORM):\n    t = np.asarray(app.world.download_field(f), dtype=np.float32)\n    assert t.size and np.isfinite(t).all() and np.abs(t).max() < 100.0, (f, t)"},

    {"action": "view.toggle_language"},
    {"action": "file.import", "args": {"path": "${scenario_dir}/../../examples/assets/bdx/open_duck_mini_v2.xml"}},
    {"frames": 8},
    {"screenshot": "06_import_wizard_zh"},
    {"action": "file.import", "args": {"path": "${scenario_dir}/../../tests/data/mounted_loads.xml", "mode": "open", "discard": true}},
    {"frames": 20},
    {"expect": {"loaded": true, "undo": 0}},
    {"action": "file.import", "args": {"path": "${scenario_dir}/../../examples/assets/bdx/assets/head.stl", "mode": "add",
     "pose": {"pos": [0.5, 0.0, 0.0], "quat": [1.0, 0.0, 0.0, 0.0]}}, "expect_value": {"focus": "head"}},
    {"expect": {"undo": 1, "loaded": true}},
    {"tick": 30},
    {"action": "window.focus", "args": {"panel": "assets"}},
    {"frames": 8},
    {"screenshot": "07_opened_zh"},
    {"action": "view.toggle_language"},

    {"action": "assets.remove_folder", "args": {"path": "${folder.path}"}},
    {"action": "assets.list", "bind": "lib2"},
    {"python": "assert ${folder}['path'] not in ${lib2}['roots'], ${lib2}['roots']"}
  ]
}
