{
  "name": "launch",
  "start_page": true,
  "launch": [],
  "steps": [
    {"expect": {"start_page": true, "session": "editor", "loaded": false, "path": "", "title": "untitled"}},
    {"frames": 20},
    {"screenshot": "start_empty"},
    {"action": "file.new", "args": {"template": "ground"}, "expect_value": {"path": "", "title": "untitled"}},
    {"expect": {"start_page": false, "loaded": true, "dirty": false}},
    {"action": "scene.spawn", "args": {"kind": "box", "pose": {"pos": [0.0, 0.0, 0.6], "quat": [1.0, 0.0, 0.0, 0.0]}}},
    {"expect": {"dirty": true}},
    {"python": "app._smoke_hash = app.document()['hash']"},
    {"action": "file.revert", "expect_error": true},
    {"action": "file.close", "expect_value": {"prompt": "file.close"}},
    {"expect": {"prompt": "file.close", "loaded": true}},
    {"frames": 12},
    {"screenshot": "prompt"},
    {"action": "app.answer_prompt", "args": {"choice": "cancel"}, "expect_value": {"choice": "cancel"}},
    {"expect": {"prompt": "", "loaded": true, "dirty": true}},
    {"action": "file.close"},
    {"action": "app.answer_prompt", "args": {"choice": "save", "path": "${out}/launch_a.nks"}},
    {"frames": 6},
    {"expect": {"start_page": true, "loaded": false, "path": "", "prompt": ""}},
    {"python": "import os, json\nrecent = json.load(open('${profile}/recent.json', encoding='utf-8'))\nassert 'launch_a.nks' in json.dumps(recent), recent\nassert len([f for f in os.listdir('${profile}/thumbnails') if f.endswith('.ppm')]) == 1"},
    {"frames": 20},
    {"screenshot": "start_recent"},
    {"action": "file.open_recent", "args": {"path": "${out}/launch_a.nks"}, "expect_value": {"title": "launch_a.nks"}},
    {"expect": {"start_page": false, "loaded": true, "dirty": false, "title": "launch_a.nks"}},
    {"python": "assert app.document()['hash'] == app._smoke_hash, (app.document()['hash'], app._smoke_hash)"},
    {"action": "scene.spawn", "args": {"kind": "sphere", "pose": {"pos": [0.3, 0.0, 0.6], "quat": [1.0, 0.0, 0.0, 0.0]}}},
    {"expect": {"dirty": true}},
    {"action": "file.autosave", "bind": "auto"},
    {"python": "import os, json\nnote = json.load(open(r'${auto.path}'[:-4] + '.json', encoding='utf-8'))\nassert note['pid'] == os.getpid() and note['path'].endswith('launch_a.nks'), note"},
    {"action": "file.revert"},
    {"expect": {"dirty": false, "loaded": true}},
    {"python": "import os\nassert app.document()['hash'] == app._smoke_hash\nassert not os.path.exists(r'${auto.path}')"},
    {"action": "scene.spawn", "args": {"kind": "box", "pose": {"pos": [-0.3, 0.0, 0.6], "quat": [1.0, 0.0, 0.0, 0.0]}}},
    {"action": "app.exit", "expect_value": {"prompt": "app.exit"}},
    {"action": "app.answer_prompt", "args": {"choice": "cancel"}},
    {"action": "file.new", "args": {"template": "empty"}, "expect_value": {"prompt": "file.new"}},
    {"action": "app.answer_prompt", "args": {"choice": "discard"}},
    {"expect": {"loaded": true, "dirty": false, "path": "", "prompt": ""}},
    {"action": "file.save_as", "args": {"path": "${out}/launch_b.nks"}},
    {"frames": 6},
    {"python": "import json, os\nnames = [os.path.basename(e['path']) for e in json.load(open('${profile}/recent.json', encoding='utf-8'))]\nassert names == ['launch_b.nks', 'launch_a.nks'], names\nassert len([f for f in os.listdir('${profile}/thumbnails') if f.endswith('.ppm')]) == 2"},
    {"action": "file.close"},
    {"expect": {"start_page": true}},
    {"action": "view.toggle_language"},
    {"frames": 20},
    {"screenshot": "start_zh"},
    {"action": "file.open_recent", "args": {"path": "${out}/launch_a.nks"}},
    {"action": "scene.spawn", "args": {"kind": "box", "pose": {"pos": [0.0, 0.3, 0.6], "quat": [1.0, 0.0, 0.0, 0.0]}}},
    {"action": "file.close"},
    {"frames": 12},
    {"screenshot": "prompt_zh"},
    {"action": "app.answer_prompt", "args": {"choice": "discard"}},
    {"action": "view.toggle_language"},
    {"action": "file.forget_recent", "args": {"path": "${out}/launch_a.nks"}},
    {"frames": 4},
    {"python": "import json, os\nnames = [os.path.basename(e['path']) for e in json.load(open('${profile}/recent.json', encoding='utf-8'))]\nassert names == ['launch_b.nks'], names"}
  ]
}
