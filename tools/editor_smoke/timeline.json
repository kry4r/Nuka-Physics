{
  "name": "timeline",
  "launch": [],
  "steps": [
    {"action": "file.open", "args": {"path": "${scenario_dir}/../../examples/assets/nuka_lab/stage.nks"}},
    {"frames": 20},
    {"action": "scene.spawn", "args": {"kind": "box", "pose": {"pos": [0.0, 0.0, 1.4], "quat": [1.0, 0.0, 0.0, 0.0]}},
     "bind": "box"},
    {"frames": 10},
    {"action": "window.layout_debug"},
    {"action": "window.toggle_timeline"},
    {"action": "window.toggle_timeline"},
    {"action": "view.frame_all"},
    {"wait": "timeline.status", "until": {"tick": 0, "head": 0, "branch": 0}},

    {"tick": 120},
    {"wait": "timeline.status", "until": {"tick": 120, "head": 120}, "bind": "rec"},
    {"python": "s = ${rec}\nassert not s['replaying'] and len(s['branches']) == 1 and s['branches'][0]['exact'], s\nassert s['keys'][0] == 0 and s['keyframes'] >= 7 and s['bytes'] > 0, s"},
    {"action": "timeline.hash", "bind": "h120"},

    {"action": "timeline.seek", "args": {"tick": 40}},
    {"wait": "timeline.status", "until": {"tick": 40, "applied": true}, "bind": "back"},
    {"python": "assert ${back}['replaying'] and ${back}['head'] == 120, ${back}"},
    {"action": "timeline.hash", "bind": "h40"},
    {"action": "timeline.seek", "args": {"to": "head"}},
    {"wait": "timeline.status", "until": {"tick": 120, "applied": true}},
    {"action": "timeline.hash", "bind": "h120b"},
    {"python": "assert ${h120b}['hash'] == ${h120}['hash'], (${h120}, ${h120b})"},
    {"action": "timeline.seek", "args": {"delta": -80}},
    {"wait": "timeline.status", "until": {"tick": 40, "applied": true}},
    {"action": "timeline.hash", "bind": "h40b"},
    {"python": "assert ${h40b}['hash'] == ${h40}['hash'], (${h40}, ${h40b})"},
    {"tick": 80},
    {"wait": "timeline.status", "until": {"tick": 120}, "bind": "replayed"},
    {"action": "timeline.hash", "bind": "h120c"},
    {"python": "s = ${replayed}\nassert ${h120c}['hash'] == ${h120}['hash'], (${h120}, ${h120c})\nassert len(s['branches']) == 1 and s['branches'][0]['exact'] and s['head'] == 120, s"},

    {"action": "timeline.seek", "args": {"tick": 60}},
    {"wait": "timeline.status", "until": {"tick": 60, "applied": true}},
    {"action": "edit.apply", "args": {"label": "Kick", "ops": [
      {"target": "${box.focus}", "field": "transform", "after": {"pos": [0.6, 0.0, 1.2], "quat": [1.0, 0.0, 0.0, 0.0]}}
    ]}},
    {"tick": 60},
    {"wait": "timeline.status", "until": {"tick": 120, "branch": 1, "ghost_shown": true}, "bind": "forked"},
    {"python": "s = ${forked}\nb = {x['id']: x for x in s['branches']}\nassert len(b) == 2 and b[1]['parent'] == 0 and b[1]['fork_tick'] == 60 and b[1]['head'] == 120, s\nassert s['ghost'] == 0 and s['ghost_on'] and b[0]['head'] == 120, s"},
    {"action": "timeline.hash", "bind": "f120"},
    {"python": "assert ${f120}['hash'] != ${h120}['hash'], ${f120}"},
    {"action": "view.frame_selected"},
    {"frames": 20},
    {"screenshot": "00_ghost"},

    {"action": "timeline.branch", "args": {"id": 0}},
    {"wait": "timeline.status", "until": {"branch": 0, "tick": 120, "applied": true}},
    {"action": "timeline.hash", "bind": "m120"},
    {"python": "assert ${m120}['hash'] == ${h120}['hash'], (${h120}, ${m120})"},
    {"action": "timeline.rename", "args": {"id": 1, "label": "kicked"}},
    {"wait": "timeline.status", "until": {"applied": true}, "bind": "named"},
    {"python": "assert [b['label'] for b in ${named}['branches']] == ['', 'kicked'], ${named}"},
    {"action": "timeline.fork", "args": {"label": "probe"}},
    {"wait": "timeline.status", "until": {"branch": 2, "applied": true}},
    {"action": "timeline.ghost", "args": {"on": false}},
    {"wait": "timeline.status", "until": {"ghost_on": false, "ghost_shown": false, "applied": true}},

    {"action": "timeline.status", "bind": "full"},
    {"python": "s = ${full}\napp.actions.run('timeline.configure', budget_mb=s['bytes'] / s['keyframes'] * 4.5 / 1048576.0)"},
    {"frames": 5},
    {"wait": "timeline.status", "until": {"applied": true}, "bind": "thin"},
    {"python": "a, b = ${full}, ${thin}\nassert b['keyframes'] < a['keyframes'] and b['bytes'] < a['bytes'], (a, b)\nassert b['keys'][0] == 0 and b['keys'][-1] == 120 and len(b['branches']) == 3, b"},
    {"action": "timeline.seek", "args": {"tick": 40}},
    {"wait": "timeline.status", "until": {"tick": 40, "applied": true}},
    {"action": "timeline.hash", "bind": "p40"},
    {"python": "assert ${p40}['hash'] == ${h40}['hash'], (${h40}, ${p40})"},
    {"action": "timeline.configure", "args": {"interval": 16, "budget_mb": 1024}},
    {"frames": 20},
    {"screenshot": "01_panel"},
    {"action": "view.language", "args": {"locale": "zh-CN"}},
    {"frames": 20},
    {"screenshot": "02_zh"},
    {"action": "view.language", "args": {"locale": "en"}},

    {"action": "timeline.seek", "args": {}, "expect_error": true},
    {"action": "timeline.branch", "args": {}, "expect_error": true},
    {"action": "timeline.configure", "args": {"interval": 0}, "expect_error": true},
    {"action": "sim.reset"},
    {"wait": "timeline.status", "until": {"tick": 0, "head": 0, "branch": 0, "applied": true}, "bind": "reset"},
    {"python": "assert len(${reset}['branches']) == 1 and ${reset}['keys'] == [0], ${reset}"},
    {"action": "file.close"},
    {"action": "app.answer_prompt", "args": {"choice": "discard"}},
    {"frames": 4},
    {"expect": {"loaded": false}},
    {"action": "timeline.seek", "args": {"tick": 1}, "expect_error": true}
  ]
}
