{
  "name": "perturb",
  "launch": [],
  "steps": [
    {"action": "file.open", "args": {"path": "${scenario_dir}/../../examples/assets/nuka_lab/stage.nks"}},
    {"frames": 20},
    {"action": "scene.spawn", "args": {"kind": "box", "pose": {"pos": [0.0, 0.0, 1.4], "quat": [1.0, 0.0, 0.0, 0.0]}},
     "bind": "box"},
    {"frames": 10},
    {"action": "view.frame_all"},
    {"wait": "timeline.status", "until": {"tick": 0, "head": 0}},
    {"tick": 30},
    {"wait": "timeline.status", "until": {"tick": 30}},

    {"action": "tool.perturb", "expect_value": {"tool": "perturb"}},
    {"action": "sim.perturb", "args": {"path": "${box.focus}", "target": [0.0, 0.5, 1.6]}, "bind": "spring"},
    {"python": "s = ${spring}\nassert s['held'] and s['stiffness'] > 0.0 and s['damping'] > 0.0, s"},
    {"frames": 8},
    {"action": "sim.loads", "bind": "l0"},
    {"python": "l = ${l0}\nassert len(l) == 1 and l[0]['path'] == '${box.focus}' and l[0]['stiffness'] > 0.0, l"},
    {"python": "import time; time.sleep(4.5)"},
    {"frames": 10},
    {"screenshot": "00_spring"},
    {"tick": 30},
    {"wait": "timeline.status", "until": {"tick": 60}},
    {"action": "timeline.hash", "bind": "h60"},
    {"tick": 30},
    {"wait": "timeline.status", "until": {"tick": 90}},
    {"frames": 8},
    {"action": "sim.loads", "bind": "l1"},
    {"python": "import math\na, b, t = ${l0}[0]['at'], ${l1}[0]['at'], [0.0, 0.5, 1.6]\nd0, d1 = math.dist(a, t), math.dist(b, t)\nassert d1 < 0.5 * d0, (d0, d1, a, b)"},
    {"action": "sim.release", "args": {"path": "${box.focus}"}},
    {"frames": 8},
    {"python": "assert app.actions.run('sim.loads') == [], app.actions.run('sim.loads')"},
    {"tick": 30},
    {"wait": "timeline.status", "until": {"tick": 120}},
    {"action": "timeline.hash", "bind": "h120"},

    {"action": "timeline.seek", "args": {"tick": 20}},
    {"wait": "timeline.status", "until": {"tick": 20, "applied": true}},
    {"frames": 8},
    {"python": "assert app.actions.run('sim.loads') == [], app.actions.run('sim.loads')"},
    {"action": "timeline.seek", "args": {"tick": 60}},
    {"wait": "timeline.status", "until": {"tick": 60, "applied": true}},
    {"action": "timeline.hash", "bind": "r60"},
    {"python": "assert ${r60}['hash'] == ${h60}['hash'], (${h60}, ${r60})"},
    {"frames": 8},
    {"action": "sim.loads", "bind": "rl"},
    {"python": "assert len(${rl}) == 1 and ${rl}[0]['path'] == '${box.focus}', ${rl}"},
    {"tick": 60},
    {"wait": "timeline.status", "until": {"tick": 120}},
    {"action": "timeline.hash", "bind": "r120"},
    {"python": "assert ${r120}['hash'] == ${h120}['hash'], (${h120}, ${r120})"},

    {"action": "sim.perturb", "args": {"path": "${box.focus}", "force": [0.0, 0.0, 20.0]}, "bind": "push"},
    {"python": "assert ${push}['held'] and ${push}['stiffness'] == 0.0, ${push}"},
    {"frames": 8},
    {"action": "sim.loads", "bind": "pl"},
    {"python": "l = ${pl}\nassert len(l) == 1 and l[0]['force'] == [0.0, 0.0, 20.0] and l[0]['stiffness'] == 0.0, l"},
    {"action": "sim.release"},
    {"frames": 8},
    {"python": "assert app.actions.run('sim.loads') == [], app.actions.run('sim.loads')"},
    {"action": "tool.perturb", "expect_value": {"tool": "select"}},
    {"action": "tool.pin", "args": {"on": true}, "expect_value": {"tool": "pin"}},
    {"action": "tool.pin", "args": {"on": false}, "expect_value": {"tool": "select"}},

    {"action": "edit.apply", "args": {"label": "Pin", "ops": [{"target": "${box.focus}", "field": "static", "after": true}]}},
    {"frames": 10},
    {"action": "sim.perturb", "args": {"path": "${box.focus}", "force": [0.0, 0.0, 1.0]}, "expect_error": true},
    {"undo": 1},
    {"frames": 10},
    {"action": "sim.perturb", "args": {"path": "${box.focus}", "force": [0.0, 0.0, 1.0]}, "expect_value": {"held": true}},
    {"action": "sim.release"},
    {"action": "file.import", "args": {"path": "${scenario_dir}/../../examples/scenes/go2_stand.urdf", "mode": "add",
     "profile": "legacy", "name": "go2", "pose": {"pos": [1.0, 0.5, 0.0], "quat": [1.0, 0.0, 0.0, 0.0]}}, "bind": "robot"},
    {"frames": 10},
    {"python": "from nuka.editor.app import ActionError\nlinks = [n['path'] for n in app.actions.run('scene.nodes', under='${robot.focus}', kind='body')]\nassert links, links\ntry:\n    app.actions.run('edit.apply', ops=[{'target': links[0], 'field': 'static', 'after': True}])\nexcept ActionError as e:\n    assert 'articulation links cannot be pinned' in str(e), e\nelse:\n    raise AssertionError('a link was pinned')\nv = app.actions.run('sim.perturb', path=links[-1], force=[0.0, 0.0, 30.0])\nassert v['held'], v"},
    {"frames": 8},
    {"action": "sim.loads", "bind": "ll"},
    {"python": "assert len(${ll}) == 1 and ${ll}[0]['path'].startswith('${robot.focus}/'), ${ll}"},
    {"action": "sim.release"},
    {"action": "sim.perturb", "args": {"path": "nope", "force": [0.0, 0.0, 1.0]}, "expect_error": true},
    {"action": "sim.perturb", "args": {"path": "${box.focus}", "target": [0.0, 0.5, 1.6], "gain": 0.0}, "expect_error": true},
    {"action": "sim.perturb", "args": {"path": "${box.focus}", "force": [1.0, 2.0]}, "expect_error": true},
    {"action": "sim.grab_particle", "args": {"particle": 100000000}, "expect_error": true},
    {"action": "file.close", "args": {"discard": true}},
    {"frames": 4},
    {"expect": {"loaded": false}},
    {"action": "sim.loads", "expect_error": true},

    {"python": "import nuka\nfrom nuka.author import Scene, materials, morphs, surfaces\ns = Scene()\ns.add_entity(morphs.Ground(), materials.Rigid(friction=0.5))\ns.add_entity(morphs.Box((0.15, 0.3, 0.15), pos=(0.0, 0.0, 0.15)), materials.Rigid(static=True, friction=0.5))\ns.add_entity(morphs.Grid(40, 40, 0.01, origin=(0.1, 0.0, 0.34)), materials.Cloth.VBD(areal_density=0.2, friction=0.5, stretch_stiffness=5000.0, poisson=0.3, bend_stiffness=1e-5, thickness=0.002), surfaces.Cloth(free=True))\nb = nuka.SceneBuilder.create('')\nfor e in s._entities[:2]:\n    s._add_rigid(b, e)\ns._add_media(b, s._entities[2])\nb.save(r'${out}/towel.nks')\nb.destroy()"},
    {"action": "file.open", "args": {"path": "${out}/towel.nks"}},
    {"frames": 30},
    {"action": "scene.select", "args": {"path": "media_0"}},
    {"action": "view.frame_selected"},
    {"wait": "timeline.status", "until": {"tick": 0, "head": 0}},
    {"tick": 10},
    {"wait": "timeline.status", "until": {"tick": 10}},
    {"frames": 8},
    {"action": "sim.grab_particle", "args": {"particle": 0}, "bind": "g0"},
    {"python": "t = ${g0}['target']\nv = app.actions.run('sim.grab_particle', particle=0, target=[t[0], t[1], t[2] + 0.1])\nassert v['particle'] == 0, v"},
    {"tick": 20},
    {"wait": "timeline.status", "until": {"tick": 30}},
    {"action": "timeline.hash", "bind": "c30"},
    {"tick": 10},
    {"wait": "timeline.status", "until": {"tick": 40}},
    {"frames": 8},
    {"action": "sim.loads", "bind": "cl"},
    {"python": "import math\nl, t = ${cl}, ${g0}['target']\nassert len(l) == 1 and l[0]['particle'] == 0, l\nassert math.dist(l[0]['at'], [t[0], t[1], t[2] + 0.1]) < 1e-4, (l, t)"},
    {"python": "import time; time.sleep(8.5)"},
    {"frames": 10},
    {"screenshot": "01_cloth"},
    {"action": "sim.release", "args": {"particle": 0}},
    {"frames": 8},
    {"python": "assert app.actions.run('sim.loads') == [], app.actions.run('sim.loads')"},
    {"python": "import numpy as np, nuka\nm = np.asarray(app.world.download_field(nuka.Field.PARTICLE_INV_MASS), dtype=np.float32).reshape(-1)\nassert m[0] > 0.0, m[:4]"},
    {"tick": 20},
    {"wait": "timeline.status", "until": {"tick": 60}},
    {"action": "timeline.hash", "bind": "c60"},
    {"action": "timeline.seek", "args": {"tick": 30}},
    {"wait": "timeline.status", "until": {"tick": 30, "applied": true}},
    {"action": "timeline.hash", "bind": "s30"},
    {"python": "assert ${s30}['hash'] == ${c30}['hash'], (${c30}, ${s30})"},
    {"tick": 30},
    {"wait": "timeline.status", "until": {"tick": 60}},
    {"action": "timeline.hash", "bind": "s60"},
    {"python": "assert ${s60}['hash'] == ${c60}['hash'], (${c60}, ${s60})"},

    {"action": "edit.apply", "args": {"label": "Pin", "ops": [{"target": "media_0", "field": "pin", "after": {"vertex": 100000, "on": true}}]},
     "expect_error": true},
    {"action": "edit.apply", "args": {"label": "Pin", "ops": [{"target": "media_0", "field": "static", "after": true}]},
     "expect_error": true},
    {"action": "edit.apply", "args": {"label": "Pin", "ops": [{"target": "media_0", "field": "pin", "after": {"vertex": 39, "on": true}}]}},
    {"frames": 10},
    {"python": "import time, numpy as np, nuka\npos = lambda: np.asarray(app.world.download_field(nuka.Field.PARTICLE_POSITION), dtype=np.float32).reshape(-1, 3)\nm = np.asarray(app.world.download_field(nuka.Field.PARTICLE_INV_MASS), dtype=np.float32).reshape(-1)\nassert m[39] == 0.0 and m[38] > 0.0, m[36:40]\na = pos()\nstart = app.actions.run('timeline.status')['tick']\napp.actions.run('sim.step', steps=30)\ndeadline = time.monotonic() + 60.0\nwhile app.actions.run('timeline.status')['tick'] < start + 30:\n    assert time.monotonic() < deadline\n    app.update(True)\nb = pos()\nassert np.allclose(a[39], b[39], atol=1e-6) and not np.allclose(a[38], b[38], atol=1e-6), (a[38:40], b[38:40])"},
    {"undo": 1},
    {"frames": 10},
    {"python": "import numpy as np, nuka\nm = np.asarray(app.world.download_field(nuka.Field.PARTICLE_INV_MASS), dtype=np.float32).reshape(-1)\nassert m[39] > 0.0, m[36:40]"},
    {"action": "file.close", "args": {"discard": true}},
    {"frames": 4},
    {"expect": {"loaded": false}}
  ]
}
