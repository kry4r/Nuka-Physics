function(nuka_verify_viewer_font path sha256 option)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "${option} does not exist: ${path}")
    endif()
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL sha256)
        message(FATAL_ERROR "${option} checksum mismatch: use the pinned official font")
    endif()
endfunction()

function(nuka_download_viewer_font url path sha256 option)
    if(NOT EXISTS "${path}")
        get_filename_component(directory "${path}" DIRECTORY)
        file(MAKE_DIRECTORY "${directory}")
        file(DOWNLOAD "${url}" "${path}.download" TLS_VERIFY ON STATUS result)
        list(GET result 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${path}.download")
            message(FATAL_ERROR "Font download failed. Set ${option} to an offline copy: ${result}")
        endif()
        file(SHA256 "${path}.download" actual)
        if(NOT actual STREQUAL sha256)
            file(REMOVE "${path}.download")
            message(FATAL_ERROR "Font download checksum mismatch. Set ${option} to the pinned official offline copy")
        endif()
        file(RENAME "${path}.download" "${path}")
    endif()
    nuka_verify_viewer_font("${path}" "${sha256}" "${option}")
endfunction()

# Nerd Fonts v3.4.0: UbuntuSans sets the UI text, MartianMono the labels and HUD, GeistMono
# values and code. NUKA_VIEWER_NERD_FONT_DIR may hold the three release archives offline.
function(nuka_resolve_viewer_fonts)
    set(NUKA_VIEWER_NERD_FONT_DIR "" CACHE PATH "Directory holding the pinned Nerd Fonts v3.4.0 .tar.xz archives")
    set(NUKA_VIEWER_CJK_FONT "" CACHE FILEPATH "Offline copy of the pinned Noto Sans CJK SC font")
    set(font_dir "${CMAKE_BINARY_DIR}/_deps/nuka-fonts")
    set(UbuntuSans_sha "0a399b03565c577ae2da9f8362e6276b0adb13bac288e49fec085c517243e27b")
    set(MartianMono_sha "e12f5ca02756268e794d06d9cb2ada93d021ec915f5a43ec2cd77355022f3624")
    set(GeistMono_sha "43ef3d73cadddea5be746e20c9f27fbaa59ceb106b8b26f7245ba2de2e46b1f6")
    set(UbuntuSans_files "UbuntuSansNerdFontPropo-Regular.ttf" "UbuntuSansNerdFontPropo-Medium.ttf" "LICENCE.txt")
    set(MartianMono_files "MartianMonoNerdFontPropo-Medium.ttf" "LICENSE")
    set(GeistMono_files "GeistMonoNerdFontPropo-Regular.otf" "LICENSE")
    foreach(family IN ITEMS UbuntuSans MartianMono GeistMono)
        if(NUKA_VIEWER_NERD_FONT_DIR)
            set(archive "${NUKA_VIEWER_NERD_FONT_DIR}/${family}.tar.xz")
            nuka_verify_viewer_font("${archive}" "${${family}_sha}" "NUKA_VIEWER_NERD_FONT_DIR")
        else()
            set(archive "${font_dir}/${family}.tar.xz")
            nuka_download_viewer_font("https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/${family}.tar.xz"
                "${archive}" "${${family}_sha}" "NUKA_VIEWER_NERD_FONT_DIR")
        endif()
        list(GET ${family}_files 0 first)
        if(NOT EXISTS "${font_dir}/${family}/${first}")
            file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${font_dir}/${family}" PATTERNS ${${family}_files})
        endif()
    endforeach()
    set(cjk_sha "2c76254f6fc379fddfce0a7e84fb5385bb135d3e399294f6eeb6680d0365b74b")
    if(NUKA_VIEWER_CJK_FONT)
        nuka_verify_viewer_font("${NUKA_VIEWER_CJK_FONT}" "${cjk_sha}" "NUKA_VIEWER_CJK_FONT")
        set(cjk "${NUKA_VIEWER_CJK_FONT}")
    else()
        set(cjk "${font_dir}/NotoSansCJKsc-Regular.otf")
        nuka_download_viewer_font(
            "https://raw.githubusercontent.com/notofonts/noto-cjk/f8d157532fbfaeda587e826d4cd5b21a49186f7c/Sans/OTF/SimplifiedChinese/NotoSansCJKsc-Regular.otf"
            "${cjk}" "${cjk_sha}" "NUKA_VIEWER_CJK_FONT")
    endif()
    # Phosphor Icons 2.1.1 (MIT): the regular face merges into every text face, the fill
    # face draws active states. NUKA_VIEWER_ICON_FONT_DIR may hold the three files offline.
    set(NUKA_VIEWER_ICON_FONT_DIR "" CACHE PATH "Directory holding Phosphor.ttf, Phosphor-Fill.ttf and LICENSE of @phosphor-icons/web 2.1.1")
    set(icon_url "https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1")
    set(Phosphor.ttf_sha "06b91e022b7ee899a63efced879392a74f0bacbda54e4467e9f663220d173a10")
    set(Phosphor-Fill.ttf_sha "a53f5d2630cab5e3b7536ecb9d69d71519a2190298c22b1f8d770dd37bc2940a")
    set(LICENSE_sha "81bb1bfd8e3730c19a3895ff4a82839980933504725960c52b1c207b29398f07")
    set(Phosphor.ttf_path "src/regular/Phosphor.ttf")
    set(Phosphor-Fill.ttf_path "src/fill/Phosphor-Fill.ttf")
    set(LICENSE_path "LICENSE")
    foreach(file IN ITEMS Phosphor.ttf Phosphor-Fill.ttf LICENSE)
        if(NUKA_VIEWER_ICON_FONT_DIR)
            nuka_verify_viewer_font("${NUKA_VIEWER_ICON_FONT_DIR}/${file}" "${${file}_sha}" "NUKA_VIEWER_ICON_FONT_DIR")
            set(icon_dir "${NUKA_VIEWER_ICON_FONT_DIR}")
        else()
            set(icon_dir "${font_dir}/Phosphor")
            nuka_download_viewer_font("${icon_url}/${${file}_path}" "${icon_dir}/${file}" "${${file}_sha}"
                "NUKA_VIEWER_ICON_FONT_DIR")
        endif()
    endforeach()
    set(NUKA_VIEWER_BODY_FONT "${font_dir}/UbuntuSans/UbuntuSansNerdFontPropo-Regular.ttf" PARENT_SCOPE)
    set(NUKA_VIEWER_STRONG_FONT "${font_dir}/UbuntuSans/UbuntuSansNerdFontPropo-Medium.ttf" PARENT_SCOPE)
    set(NUKA_VIEWER_DISPLAY_FONT "${font_dir}/MartianMono/MartianMonoNerdFontPropo-Medium.ttf" PARENT_SCOPE)
    set(NUKA_VIEWER_MONO_FONT "${font_dir}/GeistMono/GeistMonoNerdFontPropo-Regular.otf" PARENT_SCOPE)
    set(NUKA_VIEWER_ICON_FONT "${icon_dir}/Phosphor.ttf" PARENT_SCOPE)
    set(NUKA_VIEWER_ICON_FILL_FONT "${icon_dir}/Phosphor-Fill.ttf" PARENT_SCOPE)
    set(NUKA_VIEWER_ICON_LICENSE "${icon_dir}/LICENSE" PARENT_SCOPE)
    set(NUKA_VIEWER_CJK_FONT_FILE "${cjk}" PARENT_SCOPE)
    set(NUKA_VIEWER_FONT_DIR "${font_dir}" PARENT_SCOPE)
endfunction()
