#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

# A minimal fixed-base prismatic-Z articulation: a pinned base and one link that
# slides only along world Z, carrying a COLLIDABLE sphere. Under gravity the link
# descends until its sphere rests on a medium below; the grid reaction must hold it
# up through the single prismatic DOF (the simplest articulated balance). A second
# prismatic-Z link is chained below to exercise the per-articulation reduction
# (two link bodies on ONE articulation share the same qdot_flat tile).
def Xform "World"
{
    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = true
        float physics:mass = 0
        double3 xformOp:translate = (0, 0, 0.235)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "slider" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        bool physics:rigidBodyEnabled = true
        float physics:mass = 0.5
        float3 physics:diagonalInertia = (0.002, 0.002, 0.002)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Sphere "foot_geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double radius = 0.04
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "slider2" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        bool physics:rigidBodyEnabled = true
        float physics:mass = 0.5
        float3 physics:diagonalInertia = (0.002, 0.002, 0.002)
        double3 xformOp:translate = (0.10, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Sphere "foot2_geom" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double radius = 0.04
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def PhysicsPrismaticJoint "joint0"
    {
        rel physics:body0 = </World/base>
        rel physics:body1 = </World/slider>
        token physics:axis = "Z"
        float physics:lowerLimit = -1.0
        float physics:upperLimit = 1.0
    }

    def PhysicsPrismaticJoint "joint1"
    {
        rel physics:body0 = </World/base>
        rel physics:body1 = </World/slider2>
        token physics:axis = "Z"
        float physics:lowerLimit = -1.0
        float physics:upperLimit = 1.0
    }

    def DistantLight "sun"
    {
        color3f inputs:color = (1, 0.95, 0.9)
        float inputs:intensity = 500
    }
}
