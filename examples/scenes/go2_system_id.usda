#usda 1.0
# =============================================================================
# go2_system_id.usda -- v0.5 gradient-based system-identification demo scene.
#
# A VERBATIM copy of examples/scenes/go2_stand.usda (the proven fixed-base Go2
# scene whose obs="qdot" mass gradients on thigh/calf links are clean). This is
# the scene used by examples/demos/go2_system_id.py to recover one unknown link
# mass by gradient descent through a CONTACT-FREE, FIXED-BASE direct-dynamics
# rollout (a hold-at-rest PD target under gravity). It is NOT a locomotion/gait
# system-ID scene: there is no ground contact and the base is fixed. One thigh
# link mass is treated as the single tunable parameter; all other masses stay at
# their scene-nominal values in both the ground-truth and the optimization rollouts.
# =============================================================================
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "mat_go2"
        {
            color3f inputs:diffuseColor = (0.12, 0.18, 0.28)
            float inputs:roughness = 0.55
            float inputs:metallic = 0.0
        }
    }

    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = true
        float physics:mass = 0
        double3 xformOp:translate = (0, 0, 0.445)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "base_collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 0.20
        }
    }

    def Xform "fl_hip" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
    )
    {
        bool physics:rigidBodyEnabled = true
        float physics:mass = 0.678
        float3 physics:diagonalInertia = (0.00088403, 0.000596003, 0.000479967)
        double3 xformOp:translate = (0.1934, 0.0465, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "fl_thigh" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI", "PhysicsMassAPI"]
