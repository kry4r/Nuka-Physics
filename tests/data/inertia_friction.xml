<mujoco model="inertia_friction">
  <default>
    <default class="act">
      <joint damping="0.3" armature="0.01" frictionloss="0.075"/>
    </default>
  </default>
  <worldbody>
    <body name="base">
      <geom type="box" size="0.1 0.1 0.1"/>
      <body name="link1" pos="0 0 0.2" childclass="act">
        <joint name="j1" type="hinge" axis="0 0 1"/>
        <inertial pos="0.01 0.02 0.1" mass="1.5" fullinertia="2 3 4 0.5 0.3 0.2"/>
        <geom type="capsule" size="0.02 0.05"/>
        <body name="link2" pos="0 0 0.2">
          <joint name="j2" type="hinge" axis="0 1 0" frictionloss="0.02"/>
          <inertial pos="0 0 0.1" mass="0.5" diaginertia="0.001 0.001 0.001"/>
          <geom type="capsule" size="0.02 0.05"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
