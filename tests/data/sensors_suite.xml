<mujoco model="sensors_suite">
  <worldbody>
    <body name="base" pos="0 0 0">
      <inertial pos="0 0 0" mass="1.0" diaginertia="0.1 0.1 0.1"/>
      <geom name="base_geom" type="box" size="0.1 0.1 0.1"/>
      <site name="head_site" pos="0 0 0.2" quat="1 0 0 0"/>
      <site name="foot_site" pos="0 0 -0.1"/>
      <camera name="onboard" pos="0.05 0 0.1" fovy="60"/>
    </body>
  </worldbody>
  <sensor>
    <rangefinder name="height_ray" site="head_site"/>
    <accelerometer name="imu_acc" site="head_site"/>
    <touch name="foot_touch" site="foot_site"/>
    <framepos name="base_pose" objtype="body" objname="base"/>
  </sensor>
</mujoco>
